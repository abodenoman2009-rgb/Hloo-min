1.supabase/functions/get-turn-credentials/index.ts
يرجع بيانات اتصال STUN/TURN ديناميكيا دون كشف المفاتيح في التطبيق (يدعم Metered أو Coturn الثابت عبر Secrets):

تي اس
import { serve } from 'https://deno.land/std@0.208.0/http/server.ts';
import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

serve(async (req) => {
  const authHeader = req.headers.get('Authorization');
  if (!authHeader) return new Response('Unauthorized', { status: 401 });

  const supabase = createClient(
    Deno.env.get('SUPABASE_URL')!,
    Deno.env.get('SUPABASE_ANON_KEY')!,
    { global: { headers: { Authorization: authHeader } } }
  );

  const { data: { user } } = await supabase.auth.getUser();
  if (!user) return new Response('Unauthorized', { status: 401 });

  const meteredKey = Deno.env.get('METERED_API_KEY');
  const meteredDomain = Deno.env.get('METERED_DOMAIN');

  if (meteredKey && meteredDomain) {
    const res = await fetch(
      `https://${meteredDomain}/api/v1/turn/credentials?apiKey=${meteredKey}`
    );
    const iceServers = await res.json();
    return new Response(JSON.stringify({ iceServers }), {
      headers: { 'Content-Type': 'application/json' },
    });
  }

  // أو استخدام خادم Coturn الخاص بك عبر Secrets
  const iceServers = [
    { urls: 'stun:stun.l.google.com:19302' },
    {
      urls: Deno.env.get('COTURN_URL')!,
      username: Deno.env.get('COTURN_USERNAME')!,
      credential: Deno.env.get('COTURN_PASSWORD')!,
    },
  ];

  return new Response(JSON.stringify({ iceServers }), {
    headers: { 'Content-Type': 'application/json' },
  });
});
