import { Platform } from 'react-native';
import {
  RTCPeerConnection,
  RTCSessionDescription,
  RTCIceCandidate,
  mediaDevices,
  MediaStream,
} from 'react-native-webrtc';
import InCallManager from 'react-native-incall-manager';
import { supabase } from './supabase';

export type CallType = 'audio' | 'video';

interface SignalPayload {
  type: 'offer' | 'answer' | 'ice-candidate' | 'hangup' | 'media-state';
  from: string;
  to?: string;
  sdp?: any;
  candidate?: any;
  audioEnabled?: boolean;
  videoEnabled?: boolean;
}

export class WebRTCManager {
  private peers = new Map<string, RTCPeerConnection>();
  private localStream: MediaStream | null = null;
  private remoteStreams = new Map<string, MediaStream>();
  private channel: ReturnType<typeof supabase.channel> | null = null;
  private iceServers: RTCIceServer[] = [{ urls: 'stun:stun.l.google.com:19302' }];

  constructor(
    private callId: string,
    private currentUserId: string,
    private callType: CallType,
    private onRemoteStreamsChange: (streams: Map<string, MediaStream>) => void,
    private onPeerEnded: (peerId: string) => void
  ) {}

  async init(): Promise<MediaStream> {
    // 1. جلب بيانات خادم TURN من Supabase Edge Function بشكل آمن
    try {
      const { data } = await supabase.functions.invoke('get-turn-credentials');
      if (data?.iceServers) {
        this.iceServers = data.iceServers;
      }
    } catch {
      // الاحتفاظ بـ STUN الاحتياطي إذا تعذر الوصول مؤقتاً
    }

    // 2. تشغيل الصوت والمايك عبر InCallManager
    if (Platform.OS !== 'web') {
      InCallManager.start({ media: this.callType === 'video' ? 'video' : 'audio' });
      InCallManager.setForceSpeakerphoneOn(this.callType === 'video');
    }

    // 3. الحصول على بث الكاميرا والميكروفون المحلي
    const stream = await mediaDevices.getUserMedia({
      audio: true,
      video:
        this.callType === 'video'
          ? { facingMode: 'user', width: { ideal: 1280 }, height: { ideal: 720 }, frameRate: { ideal: 30 } }
          : false,
    });
    this.localStream = stream as MediaStream;

    // 4. الاشتراك بقناة Signaling الفورية الخاصة بالمكالمة
    this.channel = supabase
      .channel(`call:${this.callId}`)
      .on('broadcast', { event: 'signal' }, async ({ payload }: { payload: SignalPayload }) => {
        if (payload.from === this.currentUserId) return;
        if (payload.to && payload.to !== this.currentUserId) return;

        switch (payload.type) {
          case 'offer':
            await this.handleOffer(payload.from, payload.sdp);
            break;
          case 'answer':
            await this.handleAnswer(payload.from, payload.sdp);
            break;
          case 'ice-candidate':
            await this.handleIceCandidate(payload.from, payload.candidate);
            break;
          case 'hangup':
            this.removePeer(payload.from);
            this.onPeerEnded(payload.from);
            break;
        }
      })
      .subscribe();

    return this.localStream;
  }

  private createPeerConnection(peerId: string): RTCPeerConnection {
    const existing = this.peers.get(peerId);
    if (existing) return existing;

    const pc = new RTCPeerConnection({
      iceServers: this.iceServers,
      iceTransportPolicy: 'all',
    });

    this.localStream?.getTracks().forEach((track) => {
      pc.addTrack(track, this.localStream!);
    });

    (pc as any).ontrack = (event: any) => {
      const [remoteStream] = event.streams;
      if (remoteStream) {
        this.remoteStreams.set(peerId, remoteStream);
        this.onRemoteStreamsChange(new Map(this.remoteStreams));
      }
    };

    (pc as any).onicecandidate = (event: any) => {
      if (event.candidate) {
        this.sendSignal({
          type: 'ice-candidate',
          from: this.currentUserId,
          to: peerId,
          candidate: event.candidate,
        });
      }
    };

    // معالجة انقطاع الاتصال وإعادة المحاولة تلقائياً (ICE Restart)
    (pc as any).oniceconnectionstatechange = async () => {
      const state = pc.iceConnectionState;
      if (state === 'failed' || state === 'disconnected') {
        try {
          const offer = await pc.createOffer({ iceRestart: true });
          await pc.setLocalDescription(offer);
          this.sendSignal({
            type: 'offer',
            from: this.currentUserId,
            to: peerId,
            sdp: offer,
          });
        } catch {
          // تجاهل إذا تم إغلاق الاتصال بالفعل
        }
      }
    };

    this.peers.set(peerId, pc);
    return pc;
  }

  async callPeer(peerId: string) {
    const pc = this.createPeerConnection(peerId);
    const offer = await pc.createOffer({});
    await pc.setLocalDescription(offer);
    await this.sendSignal({
      type: 'offer',
      from: this.currentUserId,
      to: peerId,
      sdp: offer,
    });
  }

  private async handleOffer(peerId: string, sdp: any) {
    const pc = this.createPeerConnection(peerId);
    await pc.setRemoteDescription(new RTCSessionDescription(sdp));
    const answer = await pc.createAnswer();
    await pc.setLocalDescription(answer);
    await this.sendSignal({
      type: 'answer',
      from: this.currentUserId,
      to: peerId,
      sdp: answer,
    });
  }

  private async handleAnswer(peerId: string, sdp: any) {
    const pc = this.peers.get(peerId);
    if (!pc) return;
    await pc.setRemoteDescription(new RTCSessionDescription(sdp));
  }

  private async handleIceCandidate(peerId: string, candidate: any) {
    const pc = this.peers.get(peerId);
    if (!pc || !candidate) return;
    await pc.addIceCandidate(new RTCIceCandidate(candidate));
  }

  toggleMute(muted: boolean) {
    this.localStream?.getAudioTracks().forEach((track) => {
      track.enabled = !muted;
    });
  }

  toggleCamera(enabled: boolean) {
    this.localStream?.getVideoTracks().forEach((track) => {
      track.enabled = enabled;
    });
  }

  switchCamera() {
    this.localStream?.getVideoTracks().forEach((track: any) => {
      if (typeof track._switchCamera === 'function') {
        track._switchCamera();
      }
    });
  }

  setSpeakerphone(enabled: boolean) {
    if (Platform.OS !== 'web') {
      InCallManager.setForceSpeakerphoneOn(enabled);
    }
  }

  private async sendSignal(payload: SignalPayload) {
    await this.channel?.send({
      type: 'broadcast',
      event: 'signal',
      payload,
    });
  }

  private removePeer(peerId: string) {
    this.peers.get(peerId)?.close();
    this.peers.delete(peerId);
    this.remoteStreams.delete(peerId);
    this.onRemoteStreamsChange(new Map(this.remoteStreams));
  }

  async cleanup() {
    await this.sendSignal({ type: 'hangup', from: this.currentUserId });
    this.peers.forEach((pc) => pc.close());
    this.peers.clear();
    this.remoteStreams.clear();
    this.localStream?.getTracks().forEach((t) => t.stop());
    this.localStream = null;
    if (Platform.OS !== 'web') {
      InCallManager.stop();
    }
    if (this.channel) {
      await supabase.removeChannel(this.channel);
      this.channel = null;
    }
  }
}
